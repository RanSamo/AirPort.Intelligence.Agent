# Required for the chat agent only.
# Ingest, metrics and scoring all run WITHOUT this key.
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Live-trend enrichment only — never feeds the ranking.
# If these are absent the OpenSky tool is not registered and everything else
# works identically. Free account: https://opensky-network.org/
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Optional. Enables the catchment demand metrics (population / median income).
# The Latent Demand pillar reweights over available metrics if this is absent.
# Free key: https://api.census.gov/data/key_signup.html
CENSUS_API_KEY=
